; Engine configuration file.
; Generated for the games monorepo (Godot project at repo root).
; JS/TS auxiliary code lives in packages/ and is ignored via .gdignore.

config_version=5

[application]

config/name="Games"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Palette="*res://shared/autoload/Palette.gd"
GameHub="*res://shared/autoload/GameHub.gd"
Net="*res://shared/autoload/Net.gd"
Cards="*res://shared/cards/Cards.gd"
Poker="*res://shared/cards/Poker.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
