{
    "name": "games-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "eslint .",
        "lint-type": "pnpm --filter './packages/*' --bail run lint-type",
        "test": "pnpm --filter @games/shared test",
        "build": "pnpm --filter '@games/web' run build",
        "dev": "concurrently -n web,server -c blue,green \"pnpm --filter @games/web dev\" \"pnpm --filter @games/server dev\"",
        "serve": "pnpm build && pnpm --filter @games/server serve",
        "lint-all": "pnpm lint && pnpm lint-type",
        "godot:editor": "${GODOT:-/Applications/Godot.app/Contents/MacOS/Godot} --editor --path .",
        "godot:play": "${GODOT:-/Applications/Godot.app/Contents/MacOS/Godot} --path .",
        "godot:export:web": "${GODOT:-/Applications/Godot.app/Contents/MacOS/Godot} --headless --path . --export-release Web dist/godot-web/index.html",
        "prepare": "husky",
        "postinstall": "node -e \"require('fs').closeSync(require('fs').openSync('node_modules/.gdignore','w'))\""
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.8.5",
        "@hero-u/eslint-config": "^1.0.4",
        "@types/node": "^25.9.1",
        "concurrently": "^9.2.1",
        "eslint": "^10.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@9.12.2"
}
